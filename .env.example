# Flask Secret Key
SECRET_KEY=super_secret_key_change_me_in_production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your actual MongoDB Atlas credentials.
# Do NOT enclose the URI in quotes if not necessary.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority&appName=Cluster0
